# ===== HerPath AI — muhit o'zgaruvchilari =====
# Lokal ishlatish: bu faylni .env.local nomi bilan nusxalang va qiymatlarni to'ldiring.
# Vercel: Project → Settings → Environment Variables bo'limiga xuddi shu nomlar bilan kiriting.

# --- AI (kamida bittasi shart; bir nechtasi bo'lsa, biri limitga yetganda keyingisiga o'tadi) ---
# Bepul kalit: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Bepul kalit: https://console.groq.com/keys
GROQ_API_KEY=
# Ixtiyoriy, PULLIK (lekin juda arzon, balansni to'ldirish kerak): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Ixtiyoriy: modellarni almashtirish
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b
# DEEPSEEK_MODEL=deepseek-chat
# Ixtiyoriy: qaysi provayder birinchi ishlatilsin (gemini | groq | deepseek)
# AI_PRIMARY=gemini


# --- Ma'lumotlar bazasi ---
# Vercel'da: Storage → Neon (Postgres) qo'shing — DATABASE_URL avtomatik qo'yiladi.
# Lokal ishlatishda bo'sh qoldirsangiz, .data/ papkasida ichki baza (PGlite) yaratiladi.
DATABASE_URL=

# --- Sessiya imzosi (production uchun shart) ---
# Uzun tasodifiy satr. Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
